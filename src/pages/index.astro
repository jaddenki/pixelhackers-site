---
import { statSync } from 'node:fs';
import '../styles/main.css';

const fontBytes = statSync('public/fonts/PixelHackers.woff2').size;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>PixelHackers</title>
    <script is:inline>
      try { if (localStorage.getItem('ph-accent') === 'pink') document.documentElement.dataset.accent = 'pink'; } catch {}
    </script>
  </head>
  <body>
    <div class="page">

      <div class="hero">
        <canvas class="hero-gliders" aria-hidden="true"></canvas>
        <div class="hero-text">
          <div class="hero-line">Pixel</div>
          <div class="hero-line">Hackers</div>
        </div>
      </div>

      <!-- Character specimen -->
      <div class="chars">
        <div class="chars-sample">AaBbCc<br>123#&amp;?<br>()[]&#123;&#125;</div>
        <canvas class="chars-canvas" aria-hidden="true"></canvas>
      </div>

      <!-- Description boxes -->
      <div class="description">
        <div class="desc-left" contenteditable="plaintext-only" spellcheck="false">Kern lead trace loop drop fill bold flat edge wide snap grid type draw curve hold back clean push render sharp pixel byte glyph.</div>
        <div class="desc-right">PixelHackers is a pixel typeface for people who touch wet paint to see if it’s wet.</div>
      </div>

      <!-- Type specimens (editable) -->
      <div class="specimens">
        <div class="specimen">
          <div class="specimen-meta">
            <span>PixelHackers</span>
            <span class="stepper" data-prop="size" data-value="144"><button type="button" aria-label="Decrease">-</button><span class="stepper-val">144pt</span><button type="button" aria-label="Increase">+</button></span>
            <span class="stepper" data-prop="tracking" data-value="-2"><button type="button" aria-label="Decrease">-</button><span class="stepper-val">-2% Tracking</span><button type="button" aria-label="Increase">+</button></span>
          </div>
          <div class="specimen-text s144" contenteditable="plaintext-only" spellcheck="false">I’m going to
change the world</div>
        </div>
      </div>

      <div class="globe"><div class="globe-stage"><canvas class="globe-map" aria-label="Spinning globe. Drag to spin, click to make a crater."></canvas><canvas class="globe-fx" aria-hidden="true"></canvas><div class="globe-quip" role="status" aria-live="polite"></div></div></div>

      <div class="wpm">
        <div class="specimen-meta">
          <span>What is your WPM?!</span>
          <span class="wpm-options">
            <span class="wpm-durations" role="group" aria-label="Test length in seconds">
              <button type="button" data-duration="15">15s</button>
              <button type="button" data-duration="30" class="is-active">30s</button>
              <button type="button" data-duration="60">60s</button>
            </span>
            <span class="wpm-durations" role="group" aria-label="View">
              <button type="button" data-mode="big" class="is-active">Big</button>
              <button type="button" data-mode="classic">Classic</button>
            </span>
          </span>
          <span class="wpm-timer" aria-label="Seconds left">30s</span>
        </div>
        <div class="wpm-box">
          <input class="wpm-input" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Type the words shown">
          <button class="wpm-start" type="button">Click to start</button>
          <div class="wpm-window">
            <div class="wpm-text"></div>
            <div class="wpm-next" aria-hidden="true"></div>
            <div class="wpm-lines"><div class="wpm-flow"></div></div>
          </div>
          <div class="wpm-space"><span class="wpm-key">Space</span> for next word</div>
          <div class="wpm-result" aria-live="polite"></div>
        </div>
      </div>

    </div>

    <div class="cta">
      <a class="cta-btn cta-primary" href="/fonts/PixelHackers.woff2" download data-bytes={fontBytes}>Download</a>
      <a class="cta-btn cta-github" href="#">GitHub</a>
    </div>

    <script>
      import { initSound }            from '../lib/sound';
      import { initAccent }           from '../lib/accent';
      import { initCursorPress }      from '../lib/cursor-press';
      import { initHeroType }         from '../lib/hero-type';
      import { initHeroGliders }      from '../lib/hero-gliders';
      import { initSpecimenControls } from '../lib/specimen-controls';
      import { initTypePixelate }     from '../lib/type-pixelate';
      import { initTypingTest }       from '../lib/typing-test';
      import { initGlobe }            from '../lib/globe';
      import { initRetype }           from '../lib/retype';
      import { initCharsFall }        from '../lib/chars-fall';
      import { initBinary }           from '../lib/binary';
      import { initWetPaint }         from '../lib/wet-paint';
      import { initReceipt }          from '../lib/receipt';

      const hero = document.querySelector<HTMLElement>('.hero')!;

      initSound();
      initAccent();
      initCursorPress();
      initHeroType(hero);
      initHeroGliders(hero, hero.querySelector<HTMLCanvasElement>('.hero-gliders')!);
      initSpecimenControls();
      initTypePixelate();
      initTypingTest(document.querySelector<HTMLElement>('.wpm')!);
      initRetype(document.querySelector<HTMLElement>('.specimen-text')!);
      initCharsFall(document.querySelector<HTMLElement>('.chars')!);
      initBinary();
      initWetPaint(document.querySelector<HTMLElement>('.desc-right')!);
      initReceipt(
        document.querySelector<HTMLAnchorElement>('.cta-primary')!,
        document.querySelector<HTMLAnchorElement>('.cta-github')!,
      );
      initGlobe(
        document.querySelector<HTMLCanvasElement>('.globe-map')!,
        document.querySelector<HTMLCanvasElement>('.globe-fx')!,
        document.querySelector<HTMLElement>('.globe-quip')!,
      );
    </script>
  </body>
</html>
